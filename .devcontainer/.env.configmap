# Non-sensitive Configuration (stored in K8s ConfigMap)
# Used by postCreate.sh to create K8s ConfigMap 'app-config' in dev container

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=flask_app

# Celery & Message Broker
CELERY_BROKER_URL=amqp://rabbituser:rabbitpass@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Frontend
REACT_APP_API_URL=http://localhost:5000

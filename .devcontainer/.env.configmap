# Non-sensitive Configuration (stored in K8s ConfigMap)
# Used by postCreate.sh to create K8s ConfigMap 'app-config' in dev container

# Database
# For the kind cluster, MySQL runs on the Docker host gateway.
#DB_HOST=host.docker.internal
DB_HOST=172.18.0.1
DB_PORT=3306
DB_NAME=flask_app

# Celery & Message Broker
CELERY_BROKER_URL=amqp://rabbituser:rabbitpass@rabbitmq.messaging.svc.cluster.local:5672//
CELERY_RESULT_BACKEND=redis://redis-master.cache.svc.cluster.local:6379/0

# Frontend
#REACT_APP_API_URL=http://localhost:5000
REACT_APP_API_URL=https://expert-doodle-vrjv6p45gqqc6qj6-5000.app.github.dev
